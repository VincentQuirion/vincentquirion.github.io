{% for social in site.data.socials %}
  {% case social[0] %}
    {% when 'academia_edu' %}
      {% assign dest = 'https://' | append: social[1].organization | append: '.academia.edu/' | append: social[1].username %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Academia.edu"><i class="ai ai-academia"></i></a>
    {% when 'acm_id' %}
      {% assign dest = 'https://dl.acm.org/profile/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="ACM DL"><i class="ai ai-acm"></i></a>
    {% when 'arxiv_id' %}
      {% assign dest = 'https://arxiv.org/a/' | append: social[1] | append: '.html' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="arXiv"><i class="ai ai-arxiv"></i></a>
    {% when 'blogger_url' %}
      {% assign dest = social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Blogger"><i class="fa-brands fa-blogger-b"></i></a>
    {% when 'bluesky_url' %}
      {% assign dest = social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
    {% when 'cv_pdf' %}
      {% assign dest = social[1] | relative_url | absolute_url %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="CV" target="_blank"><i class="ai ai-cv"></i></a>
    {% when 'dblp_url' %}
      {% assign dest = social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="DBLP"><i class="ai ai-dblp"></i></a>
    {% when 'discord_id' %}
      {% assign dest = 'https://discord.com/users/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Discord"><i class="fa-brands fa-discord"></i></a>
    {% when 'email' %}
      {% assign dest = 'mailto:' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="email"><i class="fa-solid fa-envelope"></i></a>
    {% when 'facebook_id' %}
      {% assign dest = 'https://facebook.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Facebook"><i class="fa-brands fa-facebook"></i></a>
    {% when 'flickr_id' %}
      {% assign dest = 'https://www.flickr.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Flickr"><i class="fa-brands fa-flickr"></i></a>
    {% when 'github_username' %}
      {% assign dest = 'https://github.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="GitHub"><i class="fa-brands fa-github"></i></a>
    {% when 'gitlab_username' %}
      {% assign dest = 'https://gitlab.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="GitLab"><i class="fa-brands fa-gitlab"></i></a>
    {% when 'hal_id' %}
      {% assign dest = 'https://cv.hal.science/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="HAL"><i class="ai ai-hal"></i></a>
    {% when 'ieee_id' %}
      {% assign dest = 'https://ieeexplore.ieee.org/author/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="IEEE Xplore"><i class="ai ai-ieee"></i></a>
    {% when 'inspirehep_id' %}
      {% assign dest = 'https://inspirehep.net/authors/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Inspire HEP"><i class="ai ai-inspire"></i></a>
    {% when 'instagram_id' %}
      {% assign dest = 'https://instagram.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
    {% when 'kaggle_id' %}
      {% assign dest = 'https://www.kaggle.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Kaggle"><i class="fa-brands fa-kaggle"></i></a>
    {% when 'keybase_username' %}
      {% assign dest = 'https://keybase.io/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Keybase"><i class="fa-brands fa-keybase"></i></a>
    {% when 'lastfm_id' %}
      {% assign dest = 'https://www.last.fm/user/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Last FM"><i class="fa-brands fa-lastfm"></i></a>
    {% when 'lattes_id' %}
      {% assign dest = 'http://lattes.cnpq.br/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" target="_blank" title="Lattes"><i class="ai ai-lattes"></i></a>
    {% when 'leetcode_id' %}
      {% assign dest = 'https://leetcode.com/u/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" target="_blank" title="LeetCode"><i class="si si-leetcode"></i></a>
    {% when 'linkedin_username' %}
      {% assign dest = 'https://www.linkedin.com/in/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
    {% when 'mastodon_username' %}
      {% assign dest = 'https://' | append: social[1] %}
      <a rel="me" href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Mastodon"><i class="fa-brands fa-mastodon"></i></a>
    {% when 'medium_username' %}
      {% assign dest = 'https://medium.com/@' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Medium"><i class="fa-brands fa-medium"></i></a>
    {% when 'orcid_id' %}
      {% assign dest = 'https://orcid.org/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="ORCID"><i class="ai ai-orcid"></i></a>
    {% when 'osf_id' %}
      {% assign dest = 'https://osf.io/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Open Science Framework"><i class="ai ai-osf"></i></a>
    {% when 'pinterest_id' %}
      {% assign dest = 'https://www.pinterest.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Pinterest"><i class="fa-brands fa-pinterest"></i></a>
    {% when 'publons_id' %}
      {% assign dest = 'https://publons.com/a/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Publons"><i class="ai ai-publons"></i></a>
    {% when 'quora_username' %}
      {% assign dest = 'https://www.quora.com/profile/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Quora"><i class="fa-brands fa-quora"></i></a>
    {% when 'research_gate_profile' %}
      {% assign dest = 'https://www.researchgate.net/profile/' | append: social[1] | append: '/' %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="ResearchGate"><i class="ai ai-researchgate"></i></a>
    {% when 'rss_icon' %}
      {% if social[1] == true %}
        {% assign dest = '/feed.xml' | absolute_url %}
        <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="RSS Feed"><i class="fa-solid fa-square-rss"></i></a>
      {% endif %}
    {% when 'scholar_userid' %}
      {% assign dest = 'https://scholar.google.com/citations?user=' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
    {% when 'scopus_id' %}
      {% assign dest = 'https://www.scopus.com/authid/detail.uri?authorId=' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Scopus"><i class="ai ai-scopus"></i></a>
    {% when 'semanticscholar_id' %}
      {% assign dest = 'https://www.semanticscholar.org/author/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Semantic Scholar"><i class="ai ai-semantic-scholar"></i></a>
    {% when 'spotify_id' %}
      {% assign dest = 'https://open.spotify.com/user/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Spotify"><i class="fa-brands fa-spotify"></i></a>
    {% when 'stackoverflow_id' %}
      {% assign dest = 'https://stackoverflow.com/users/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Stackoverflow"><i class="fa-brands fa-stack-overflow"></i></a>
    {% when 'strava_userid' %}
      {% assign dest = 'https://www.strava.com/athletes/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Strava"><i class="fa-brands fa-strava"></i></a>
    {% when 'telegram_username' %}
      {% assign dest = 'https://telegram.me/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="telegram"><i class="fa-brands fa-telegram"></i></a>
    {% when 'unsplash_id' %}
      {% assign dest = 'https://unsplash.com/@' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Unsplash"><i class="fa-brands fa-unsplash"></i></a>
    {% when 'wechat_qr' %}
      <a id="WeChatBtn" title="WeChat"><i class="fa-brands fa-weixin"></i></a>
      <div id="WeChatMod" class="wechat-modal">
        <img src="{{ social[1] | prepend: 'assets/img/' | relative_url }}" alt="WeChat QR" id="WeChatQR">
      </div>
      <script defer src="{{ '/assets/js/wechat.js' | relative_url | bust_file_cache }}" type="text/javascript"></script>
    {% when 'whatsapp_number' %}
      {% assign dest = 'https://wa.me/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="whatsapp"><i class="fa-brands fa-whatsapp"></i></a>
    {% when 'wikidata_id' %}
      {% assign dest = 'https://www.wikidata.org/wiki/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Wikidata"><i class="fa-solid fa-barcode"></i></a>
    {% when 'wikipedia_id' %}
      {% assign dest = 'https://wikipedia.org/wiki/User:' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Wikipedia"><i class="fa-brands fa-wikipedia-w"></i></a>
    {% when 'work_url' %}
      {% assign dest = social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Work"><i class="fa-solid fa-briefcase"></i></a>
    {% when 'x_username' %}
      {% assign dest = 'https://twitter.com/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="X"><i class="fa-brands fa-x-twitter"></i></a>
    {% when 'youtube_id' %}
      {% assign dest = 'https://youtube.com/@' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="YouTube"><i class="fa-brands fa-youtube"></i></a>
    {% when 'zotero_username' %}
      {% assign dest = 'https://www.zotero.org/' | append: social[1] %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="Zotero"><i class="ai ai-zotero"></i></a>
    {% else %}
      {% assign dest = social[1].url %}
      <a href="{{ site.baseurl }}/go/?url={{ dest | url_encode }}" title="{{ social[1].title }}">
        {% assign file_ext = social[1].logo | split: '.' | last %}
        {% if file_ext == 'svg' %}
          <svg>
            <image xlink:href="{% if social[1].logo contains '://' %}{{ social[1].logo }}{% else %}{{ social[1].logo | relative_url }}{% endif %}" />
          </svg>
        {% else %}
          <img
            src="{% if social[1].logo contains '://' %}{{ social[1].logo }}{% else %}{{ social[1].logo | relative_url }}{% endif %}"
            alt="{{ social[1].title }}"
          >
        {% endif %}
      </a>
  {% endcase %}
{% endfor %}
